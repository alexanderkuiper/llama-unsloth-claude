# --- Model Selection ---
# To swap models, just change these two lines and run 'docker-compose up -d'

# Option 1: Smaller, faster - 35B model with 3-bit quantization (~13GB RAM)
# MODEL_REPO=unsloth/Qwen3.6-53B-A38-GGUF
# MODEL_FILE=Qwen3.6-53B-A3B-UD-Q3_K_M.gguf

# Option 2: Larger, better quality - 53B model with 4-bit quantization (~22GB RAM)
MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf

N_GPU_LAYERS=99
CTX_SIZE=32768

